    given-names: Leo Y.
    orcid: "https://orcid.org/0009-0008-1145-7969"
repository-code: "https://github.com/Leo-Y-Zhang/DiscrepancyRecords"
license-url: "https://github.com/Leo-Y-Zhang/DiscrepancyRecords/blob/main/LICENSE"
