# Bulk solver artifacts - regenerated and hash-matched, never committed
evidence/drat/
*.drat
evidence/**/*.cnf
evidence/*.cnf

# The DIMACS writer streams the body to a sibling temp file and unlinks it in a
# finally block. A killed run skips that, and the leftover is named
# `<instance>.cnf.body.tmp`, which the `*.cnf` patterns above do not match.
*.body.tmp

# Local scratch
scratch/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.venv/
